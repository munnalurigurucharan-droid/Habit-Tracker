// ==========================================================
// Habit Tracker - Prisma Schema (PostgreSQL)
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------
// A registered user of the tracker (single-tenant per user).
// ----------------------------------------------------------
model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  habits       Habit[]
  monthConfigs MonthConfig[]

  @@map("users")
}

// ----------------------------------------------------------
// A single habit row in the tracker table, e.g. "Running".
// `monthlyGoal` = target number of check-ins for the active
// month (the "GOALS" column in the sheet).
// `sortOrder` preserves the row order the user arranged.
// ----------------------------------------------------------
model Habit {
  id          String        @id @default(uuid())
  userId      String
  name        String
  monthlyGoal Int           @default(30)
  sortOrder   Int           @default(0)
  isArchived  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries     HabitEntry[]

  @@index([userId, isArchived])
  @@map("habits")
}

// ----------------------------------------------------------
// One checkbox cell: whether `habit` was completed on `date`.
// Unique per (habit, date) so toggling is an upsert.
// ----------------------------------------------------------
model HabitEntry {
  id        String   @id @default(uuid())
  habitId   String
  date      DateTime @db.Date
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([date])
  @@map("habit_entries")
}

// ----------------------------------------------------------
// The "Calendar Settings" panel (Year / Month selector) plus
// any per-month display preferences, one row per user+month.
// ----------------------------------------------------------
model MonthConfig {
  id        String   @id @default(uuid())
  userId    String
  year      Int
  month     Int      // 1-12
  startsOn  Int      @default(3) // 0=Sun..6=Sat; sheet starts on Wed
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@map("month_configs")
}
